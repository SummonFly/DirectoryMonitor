<Window x:Class="DirectoryMonitor.Views.WatchedPathEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Watched Path" Height="450" Width="600"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Path -->
        <Label Grid.Row="0" Content="Path:" FontWeight="Bold" Margin="0,0,0,5"/>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="40"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="PathBox" IsReadOnly="True" Background="#F0F0F0" Margin="0,0,5,0"/>
            <Button x:Name="BrowseButton" Grid.Column="1" Content="..." Click="BrowseButton_Click"/>
        </Grid>


        <!-- Options -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,15">
            <CheckBox x:Name="IncludeSubdirectoriesBox" Content="Include Subdirectories" Margin="0,0,20,0" IsChecked="True"/>
            <CheckBox x:Name="IsActiveBox" Content="Active" IsChecked="True"/>
            <CheckBox x:Name="WaitForCreationBox" Content="Wait for folder creation" Margin="20,0,0,0" IsChecked="False"/>
        </StackPanel>

        <!-- Rules List -->
        <GroupBox Grid.Row="3" Header="Applied Rules" Margin="0,0,0,10">
            <ListBox x:Name="RulesListBox" DisplayMemberPath="Name" SelectionMode="Multiple"/>
        </GroupBox>

        <!-- Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="OkButton" Content="Save" Width="80" Margin="0,0,5,0" 
                    Background="#4CAF50" Foreground="White" BorderThickness="0" Padding="8,4" Click="OkButton_Click"/>
            <Button x:Name="CancelButton" Content="Cancel" Width="80" 
                    Background="#9E9E9E" Foreground="White" BorderThickness="0" Padding="8,4" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>