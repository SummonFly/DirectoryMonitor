<UserControl x:Class="DirectoryMonitor.Views.RuleCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Margin="0,4,0,4" Padding="12" CornerRadius="8" Background="{DynamicResource BackgroundSecondary}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Status -->
            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20" 
                    Background="{Binding IsActive, Converter={StaticResource ActiveToColor}}">
                <TextBlock Text="{Binding IsActive, Converter={StaticResource ActiveToIcon}}" 
                           FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
            </Border>

            <!-- Info -->
            <StackPanel Grid.Column="1" Margin="12,0">
                <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}"/>
                <TextBlock Text="{Binding ConditionDescription}" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="Event: " Foreground="{DynamicResource TextSecondary}"/>
                    <TextBlock Text="{Binding EventType}" Foreground="{DynamicResource TextSecondary}" Margin="0,0,15,0"/>
                    <TextBlock Text="Priority: " Foreground="{DynamicResource TextSecondary}"/>
                    <TextBlock Text="{Binding Priority}" Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>
            </StackPanel>

            <!-- Actions -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Edit" Width="60" Margin="5,0" 
                        Command="{Binding DataContext.EditRuleWithParameterCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding}"/>
                <Button Content="Delete" Width="60" Margin="5,0"
                        Command="{Binding DataContext.DeleteRuleWithParameterCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>