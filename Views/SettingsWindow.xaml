<Window x:Class="DirectoryMonitor.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="450" Width="500"
        WindowStartupLocation="CenterOwner"
        Style="{DynamicResource WindowStyle}">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Theme -->
        <Label Grid.Row="0" Content="Appearance" FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>
        <StackPanel Grid.Row="1" Margin="20,0,0,10">
            <Label Content="Theme:"/>
            <ComboBox x:Name="ThemeCombo" Width="150" Margin="0,5,0,0">
                <ComboBoxItem Content="Light"/>
                <ComboBoxItem Content="Dark"/>
            </ComboBox>
        </StackPanel>

        <!-- Watcher -->
        <Label Grid.Row="2" Content="Watcher Settings" FontWeight="Bold" FontSize="14" Margin="0,10,0,5"/>
        <StackPanel Grid.Row="3" Margin="20,0,0,10">
            <Label Content="Debounce interval (ms):"/>
            <TextBox x:Name="DebounceBox" Width="100" Style="{DynamicResource Input}" Margin="0,5,0,0" Text="300"/>
        </StackPanel>

        <!-- Journal -->
        <Label Grid.Row="4" Content="Journal Settings" FontWeight="Bold" FontSize="14" Margin="0,10,0,5"/>
        <StackPanel Grid.Row="5" Margin="20,0,0,10">
            <Label Content="Max log entries in UI:"/>
            <TextBox x:Name="MaxLogEntriesBox" Width="100" Style="{DynamicResource Input}" Margin="0,5,0,10" Text="200"/>
            <Label Content="Log retention (days):"/>
            <TextBox x:Name="LogRetentionBox" Width="100" Style="{DynamicResource Input}" Margin="0,5,0,0" Text="30"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="SaveButton" Content="Save" Width="80" Margin="0,0,5,0"  BorderThickness="0" Padding="8,4" Click="SaveButton_Click"/>
            <Button x:Name="CancelButton" Content="Cancel" Width="80"  BorderThickness="0" Padding="8,4" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>