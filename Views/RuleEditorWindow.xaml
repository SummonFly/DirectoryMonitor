<Window x:Class="DirectoryMonitor.Views.RuleEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rule Editor" Height="650" Width="850"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5"
        xmlns:local="clr-namespace:DirectoryMonitor.ViewModels"
        xmlns:converters="clr-namespace:DirectoryMonitor.Converters">

    <Window.Resources>
        <!-- Converter for extensions list to string -->
        <converters:ListToStringConverter x:Key="ListToStringConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Name -->
        <Label Grid.Row="0" Content="Rule Name:" FontWeight="Bold" Margin="0,0,0,5"/>
        <TextBox x:Name="NameBox" Grid.Row="1" Margin="0,0,0,10" Height="30"/>

        <!-- Priority and Event Type -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                <Label Content="Priority:" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBox x:Name="PriorityBox" Width="80" Margin="5,0,0,0" Height="25" Text="100"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Label Content="Event Type:" FontWeight="Bold" VerticalAlignment="Center"/>
                <ComboBox x:Name="EventTypeCombo" Width="120" Margin="5,0,0,0" Height="25">
                    <ComboBoxItem Content="Created"/>
                    <ComboBoxItem Content="Changed"/>
                    <ComboBoxItem Content="Deleted"/>
                    <ComboBoxItem Content="Renamed"/>
                </ComboBox>
            </StackPanel>
        </StackPanel>

        <!-- Tab Control -->
        <TabControl Grid.Row="3" Margin="0,0,0,10">
            <!-- Conditions Tab -->
            <TabItem Header="Conditions">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Toolbar -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button x:Name="AddGroupButton" Content="Add Group (AND)" Width="130" Margin="0,0,5,0" Click="AddGroupButton_Click"/>
                        <Button x:Name="AddConditionButton" Content="Add Condition" Width="110" Margin="5,0,5,0" Click="AddConditionButton_Click"/>
                        <Button x:Name="RemoveNodeButton" Content="Remove Selected" Width="120" Margin="5,0,5,0" Click="RemoveNodeButton_Click"/>
                    </StackPanel>

                    <TreeView x:Name="ConditionsTree" Grid.Row="1" SelectedItemChanged="ConditionsTree_SelectedItemChanged">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="True"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}" >
                                <StackPanel Orientation="Horizontal">
                                    <!-- Group -->
                                    <StackPanel Orientation="Horizontal" x:Name="GroupPanel">
                                        <TextBlock Text="GROUP: " FontWeight="Bold" Foreground="Blue"/>
                                        <ComboBox x:Name="GroupOperatorCombo" Width="70" 
                                                  SelectedValuePath="Content"
                                                    SelectedValue="{Binding OperatorString, Mode=TwoWay}">
                                            <ComboBoxItem Content="AND"/>
                                            <ComboBoxItem Content="OR"/>
                                            <ComboBoxItem Content="NOT"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- Extension -->
                                    <StackPanel Orientation="Horizontal" x:Name="ExtensionPanel">
                                        <TextBlock Text="Extension: " FontWeight="Bold" Foreground="Green"/>
                                        <TextBlock Text="{Binding ExtensionsText}"/>
                                    </StackPanel>

                                    <!-- FileName -->
                                    <StackPanel Orientation="Horizontal" x:Name="FileNamePanel">
                                        <TextBlock Text="File Name: " FontWeight="Bold" Foreground="DarkOrange"/>
                                        <TextBlock Text="{Binding Pattern}"/>
                                    </StackPanel>

                                    <!-- Size -->
                                    <StackPanel Orientation="Horizontal" x:Name="SizePanel">
                                        <TextBlock Text="Size: " FontWeight="Bold" Foreground="Red"/>
                                        <TextBlock Text="{Binding DisplayText}"/>
                                    </StackPanel>

                                    <!-- ItemType -->
                                    <StackPanel Orientation="Horizontal" x:Name="ItemTypePanel">
                                        <TextBlock Text="Item Type: " FontWeight="Bold" Foreground="Purple"/>
                                        <TextBlock Text="{Binding DisplayType}"/>
                                    </StackPanel>
                                </StackPanel>

                                <HierarchicalDataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsGroup}" Value="False">
                                        <Setter TargetName="GroupPanel" Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsExtension}" Value="False">
                                        <Setter TargetName="ExtensionPanel" Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsFileName}" Value="False">
                                        <Setter TargetName="FileNamePanel" Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSize}" Value="False">
                                        <Setter TargetName="SizePanel" Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsItemType}" Value="False">
                                        <Setter TargetName="ItemTypePanel" Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </HierarchicalDataTemplate.Triggers>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            </TabItem>

            <!-- Actions Tab -->
            <TabItem Header="Actions">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button x:Name="AssignActionButton" Content="Assign Existing Action" Width="150" Margin="0,0,5,0" Click="AssignActionButton_Click"/>
                        <Button x:Name="RemoveActionButton" Content="Remove Selected" Width="120" Margin="5,0,0,0" Click="RemoveActionButton_Click"/>
                    </StackPanel>

                    <DataGrid x:Name="ActionsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" AlternatingRowBackground="#FAFAFA">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding ActionType}" Width="120"/>
                            <DataGridTextColumn Header="Order" Binding="{Binding Order}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="OkButton" Content="Save" Width="80" Margin="0,0,5,0" 
                    Background="#4CAF50" Foreground="White" BorderThickness="0" Padding="8,4" Click="OkButton_Click"/>
            <Button x:Name="CancelButton" Content="Cancel" Width="80" 
                    Background="#9E9E9E" Foreground="White" BorderThickness="0" Padding="8,4" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>