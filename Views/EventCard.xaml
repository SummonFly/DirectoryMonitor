<UserControl x:Class="DirectoryMonitor.Views.EventCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Margin="0,4,0,4" Padding="10" CornerRadius="4" Background="{DynamicResource BackgroundSecondary}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Event Type Icon -->
            <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16" 
                    Background="{Binding EventTypeColor}">
                <TextBlock Text="{Binding EventTypeIcon}" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondary}"/>
            </Border>

            <!-- Event Info -->
            <StackPanel Grid.Column="1" Margin="10,0">
                <TextBlock Text="{Binding Path}" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="{Binding Timestamp, StringFormat=yyyy-MM-dd HH:mm:ss}" Foreground="{DynamicResource TextSecondary}"/>
                    <TextBlock Text="{Binding EventType}" Foreground="{Binding EventTypeColor}" Margin="10,0,0,0"/>
                    <TextBlock Text="{Binding OldPath}" Foreground="{DynamicResource TextSecondary}" Margin="10,0,0,0" 
                               Visibility="{Binding HasOldPath, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>