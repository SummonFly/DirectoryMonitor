<Window x:Class="DirectoryMonitor.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        xmlns:local="clr-namespace:DirectoryMonitor.Views"
        Title="Directory Monitor" Height="800" Width="1200"
        WindowStartupLocation="CenterScreen" Icon="/icon.ico" Style="{DynamicResource WindowStyle}">

    
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="24"/>
        </Grid.RowDefinitions>

        <tb:TaskbarIcon x:Name="TrayIcon"
                        IconSource="/icon.ico"
                        ToolTipText="Directory Monitor"
                        DoubleClickCommand="{Binding ShowWindowCommand}">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Show Window" Command="{Binding ShowWindowCommand}"/>
                    <Separator/>
                    <MenuItem Header="Exit" Command="{Binding ExitCommand}"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <Border Grid.Row="0" CornerRadius="8" Margin="4" Background="{DynamicResource BackgroundSecondary}">
            <StackPanel Orientation="Horizontal" Margin="16 0">
                <Border Background="{DynamicResource BackgroundPrimary}" BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="2" Height="40" Width="24" CornerRadius="12" Margin="4"/>
                <Border Background="{DynamicResource BackgroundSecondary}" BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="2" Height="40" Width="24" CornerRadius="12" Margin="4"/>
                <Border Background="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="2" Height="40" Width="24" CornerRadius="12" Margin="4"/>
                <Border Background="{DynamicResource TextSecondary}" BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="2" Height="40" Width="24" CornerRadius="12" Margin="4"/>

                <Button Margin="16,8,8,8" Visibility="Hidden"/>
                <Button Content="Settings" Click="OpenSettingButton_Click" Margin="16,8,8,8"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" CornerRadius="8" Margin="4">
            <TabControl Style="{DynamicResource PrettyTabControl}">
                <!-- Watched Paths Tab -->
                <TabItem Header="Watched Paths" Style="{DynamicResource PrettyTabItem}">
                    <Grid Style="{DynamicResource PrettyGrid}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Style="{DynamicResource Substrate}">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Add Folder" Width="100" Command="{Binding AddPathCommand}"/>
                                <Button Content="Refresh" Width="80" Margin="10,0,0,0" Command="{Binding RefreshPathsCommand}"/>
                            </StackPanel>
                        </Border>

                        <!-- Custom List -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding WatchedPaths}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <local:WatchedPathCard DataContext="{Binding}" Margin="4,0,4,0"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </TabItem>
                <!-- Journal Tab -->
                <TabItem Header="Journal" x:Name="JournalTab" Style="{DynamicResource PrettyTabItem}">
                    <Grid Style="{DynamicResource PrettyGrid}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Filters -->
                        <Border Grid.Row="0" Style="{DynamicResource Substrate}">
                            <StackPanel Orientation="Horizontal">
                                <Label Content="Event Type:"/>
                                <ComboBox  Width="120" Margin="5" 
                                    SelectedValue="{Binding EventTypeFilter}">
                                    <ComboBox.ItemsSource>
                                        <x:Array Type="{x:Type sys:String}">
                                            <sys:String>All</sys:String>
                                            <sys:String>Created</sys:String>
                                            <sys:String>Changed</sys:String>
                                            <sys:String>Deleted</sys:String>
                                            <sys:String>Renamed</sys:String>
                                        </x:Array>
                                    </ComboBox.ItemsSource>
                                </ComboBox>

                                <Label Content="Search:" Margin="10,0,0,0"/>
                                <TextBox x:Name="SearchBox" Width="200" Margin="5"  Style="{DynamicResource Input}"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>

                                <Button Content="Refresh" Width="80" Margin="10,0,0,0" 
                        Command="{Binding LoadEventsCommand}"/>
                            </StackPanel>
                        </Border>

                        <!-- Custom Events List -->
                        <ListBox Grid.Row="1" 
                            ItemsSource="{Binding Events}"
                            VirtualizingPanel.IsVirtualizing="True"
                            VirtualizingPanel.VirtualizationMode="Recycling"
                            ScrollViewer.IsDeferredScrollingEnabled="True">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <local:EventCard DataContext="{Binding}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.Template>
                                <ControlTemplate TargetType="ListBox">
                                    <ScrollViewer>
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ListBox.Template>
                        </ListBox>
                    </Grid>
                </TabItem>


                <!-- Rules Tab -->
                <TabItem x:Name="RulesTab" Header="Rules" Style="{DynamicResource PrettyTabItem}">
                    <Grid Style="{DynamicResource PrettyGrid}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Toolbar -->
                        <Border Grid.Row="0" Style="{DynamicResource Substrate}">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Add Rule" Width="100" Command="{Binding AddRuleCommand}"/>
                                <Button Content="Refresh" Width="80" Margin="10,0,0,0" Command="{Binding RefreshRulesCommand}"/>
                            </StackPanel>
                        </Border>

                        <!-- Custom List -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Rules}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <local:RuleCard DataContext="{Binding}" Margin="4,0,4,0"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </TabItem>


                <!-- Actions Tab -->
                <TabItem x:Name="ActionsTab" Header="Actions" Style="{DynamicResource PrettyTabItem}">
                    <Grid Style="{DynamicResource PrettyGrid}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Toolbar -->
                        <Border Grid.Row="0" Style="{DynamicResource Substrate}">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Add Action" Width="100" Command="{Binding AddActionCommand}"/>
                                <Button Content="Refresh" Width="80" Margin="10,0,0,0" Command="{Binding LoadActionsCommand}"/>
                            </StackPanel>
                        </Border>

                        <!-- Custom List -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Actions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <local:ActionCard DataContext="{Binding}" Margin="4,0,4,0"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <!-- System Logs -->
                <TabItem Header="System Logs" Style="{DynamicResource PrettyTabItem}" x:Name="SystemLogsTab">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Toolbar -->
                        <Border Grid.Row="0" Margin="0,0,0,10" Padding="8" Background="{DynamicResource LightGrayColorBrush}" CornerRadius="8">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Clear" Width="80" Command="{Binding ClearLogsCommand}"/>
                                <Button Content="Refresh" Width="80" Margin="10,0,0,0" Command="{Binding LoadLogsCommand}"/>
                            </StackPanel>
                        </Border>

                        <!-- Logs List -->
                        <ListBox Grid.Row="1" 
                            ItemsSource="{Binding Logs}"
                            ScrollViewer.CanContentScroll="True">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <local:SystemLogCard DataContext="{Binding}" Margin="4,0,4,0"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>
        
        <Border Grid.Row="2" CornerRadius="4" Margin="4" Background="{DynamicResource BackgroundSecondary}"/>
    </Grid>
</Window>