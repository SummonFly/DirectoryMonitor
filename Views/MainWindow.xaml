<Window x:Class="DirectoryMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        xmlns:local="clr-namespace:DirectoryMonitor.Views"
        Title="Directory Monitor" Height="800" Width="1200"
        WindowStartupLocation="CenterScreen" Icon="/icon.ico" Style="{DynamicResource WindowStyle}">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="24"/>
        </Grid.RowDefinitions>

        <tb:TaskbarIcon x:Name="TrayIcon"
                        IconSource="/icon.ico"
                        ToolTipText="Directory Monitor"
                        DoubleClickCommand="{Binding ShowWindowCommand}">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Show Window" Command="{Binding ShowWindowCommand}"/>
                    <Separator/>
                    <MenuItem Header="Exit" Command="{Binding ExitCommand}"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <Border Grid.Row="0" CornerRadius="8" Margin="4" Background="{DynamicResource DustyBlueColorBrush}">
            <StackPanel Orientation="Horizontal" Margin="16 0">
                <Border Background="{DynamicResource DeepGreenColorBrush}" Height="40" Width="24" CornerRadius="12" Margin="4"/>
                <Border Background="{DynamicResource SnowWhiteColorBrush}" Height="40" Width="24" CornerRadius="12" Margin="4"/>
                <Border Background="{DynamicResource LightGrayColorBrush}" Height="40" Width="24" CornerRadius="12" Margin="4"/>
                <Border Background="{DynamicResource SageGreenColorBrush}" Height="40" Width="24" CornerRadius="12" Margin="4"/>

                <Separator Margin="8"/>
                <Button Content="Settings" Click="OpenSettingButton_Click"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" CornerRadius="8" Margin="4">
            <TabControl Style="{DynamicResource PrettyTabControl}">
                <!-- Watched Paths Tab -->
                <TabItem Header="Watched Paths" Style="{DynamicResource PrettyTabItem}">
                    <Grid Style="{DynamicResource PrettyGrid}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Style="{DynamicResource Substrate}">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Add Folder" Width="100" Command="{Binding AddPathCommand}"/>
                                <Button Content="Refresh" Width="80" Margin="10,0,0,0" Command="{Binding RefreshPathsCommand}"/>
                            </StackPanel>
                        </Border>

                        <!-- Custom List -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding WatchedPaths}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <local:WatchedPathCard DataContext="{Binding}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </TabItem>
                <!-- Journal Tab -->
                <TabItem Header="Journal" x:Name="JournalTab" Style="{DynamicResource PrettyTabItem}">
                    <Grid Style="{DynamicResource PrettyGrid}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Filters -->
                        <Border Grid.Row="0" Style="{DynamicResource Substrate}">
                            <StackPanel Orientation="Horizontal">
                                <Label Content="Event Type:"/>
                                <ComboBox x:Name="EventTypeFilter" Width="120" Margin="5" 
                          SelectedValue="{Binding EventTypeFilter}"
                          SelectedValuePath="Tag">
                                    <ComboBoxItem Content="All" Tag="All" IsSelected="True"/>
                                    <ComboBoxItem Content="Created" Tag="Created"/>
                                    <ComboBoxItem Content="Changed" Tag="Changed"/>
                                    <ComboBoxItem Content="Deleted" Tag="Deleted"/>
                                    <ComboBoxItem Content="Renamed" Tag="Renamed"/>
                                </ComboBox>

                                <Label Content="Search:" Margin="10,0,0,0"/>
                                <TextBox x:Name="SearchBox" Width="200" Margin="5" 
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>

                                <Button Content="Refresh" Width="80" Margin="10,0,0,0" 
                        Command="{Binding LoadEventsCommand}"/>
                            </StackPanel>
                        </Border>

                        <!-- Custom Events List -->
                        <ListBox Grid.Row="1" 
                            ItemsSource="{Binding Events}"
                            VirtualizingPanel.IsVirtualizing="True"
                            VirtualizingPanel.VirtualizationMode="Recycling"
                            ScrollViewer.IsDeferredScrollingEnabled="True">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <local:EventCard DataContext="{Binding}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.Template>
                                <ControlTemplate TargetType="ListBox">
                                    <ScrollViewer>
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ListBox.Template>
                        </ListBox>
                    </Grid>
                </TabItem>


                <!-- Rules Tab -->
                <TabItem x:Name="RulesTab" Header="Rules" FontWeight="SemiBold" Style="{DynamicResource PrettyTabItem}">
                    <Grid Style="{DynamicResource PrettyGrid}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Toolbar -->
                        <Border Grid.Row="0" Style="{DynamicResource Substrate}">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Add Rule" Width="100" Command="{Binding AddRuleCommand}"/>
                                <Button Content="Refresh" Width="80" Margin="10,0,0,0" Command="{Binding RefreshRulesCommand}"/>
                            </StackPanel>
                        </Border>

                        <!-- Custom List -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Rules}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <local:RuleCard DataContext="{Binding}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <!-- Rules Log -->
                <TabItem x:Name="RuleLogTab" Header="Rule Log" Style="{DynamicResource PrettyTabItem}">
                    <Grid Style="{DynamicResource PrettyGrid}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{DynamicResource Substrate}">
                            <Button Content="Clear Log" Width="100" Command="{Binding ClearLogsCommand}"
            Background="#F44336" Foreground="White" BorderThickness="0" Padding="8,4"/>
                        </Border>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding Logs}" AutoGenerateColumns="False"
                AlternatingRowBackground="#FAFAFA" BorderBrush="#D0D0D0" RowHeight="35">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="140"/>
                                <DataGridTextColumn Header="Rule" Binding="{Binding RuleName}" Width="150"/>
                                <DataGridTextColumn Header="Event Type" Binding="{Binding EventType}" Width="100"/>
                                <DataGridTextColumn Header="Path" Binding="{Binding EventPath}" Width="*"/>
                                <DataGridCheckBoxColumn Header="Success" Binding="{Binding Success}" Width="80"/>
                                <DataGridTextColumn Header="Error" Binding="{Binding ErrorMessage}" Width="200"/>
                                <DataGridTextColumn Header="Time (ms)" Binding="{Binding ExecutionTimeMs}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- Actions Tab -->
                <TabItem x:Name="ActionsTab" Header="Actions" Style="{DynamicResource PrettyTabItem}">
                    <Grid Style="{DynamicResource PrettyGrid}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Toolbar -->
                        <Border Grid.Row="0" Style="{DynamicResource Substrate}">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Add Action" Width="100" Command="{Binding AddActionCommand}"/>
                                <Button Content="Refresh" Width="80" Margin="10,0,0,0" Command="{Binding LoadActionsCommand}"/>
                            </StackPanel>
                        </Border>

                        <!-- Custom List -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Actions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <local:ActionCard DataContext="{Binding}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>
        
        <Border Grid.Row="2" CornerRadius="4" Margin="4" Background="{DynamicResource DustyBlueColorBrush}"/>
    </Grid>
</Window>