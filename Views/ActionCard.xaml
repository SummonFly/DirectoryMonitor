<UserControl x:Class="DirectoryMonitor.Views.ActionCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Margin="0,4,0,4" Padding="12" CornerRadius="4" Background="{DynamicResource BackgroundSecondary}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Icon -->
            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20" Background="{DynamicResource BackgroundPrimary}" BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="2">
                <TextBlock Text="A" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
            </Border>

            <!-- Info -->
            <StackPanel Grid.Column="1" Margin="12,0">
                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextSecondary}" FontWeight="Bold"/>
                <TextBlock Text="{Binding ActionType}" Foreground="{DynamicResource TextSecondary}"/>
                <TextBlock Text="{Binding ParametersSummary}" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Actions -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Edit" Width="60" Margin="5,0" 
                        Command="{Binding DataContext.EditActionWithParameterCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding}"/>
                <Button Content="Delete" Width="60" Margin="5,0"
                        Command="{Binding DataContext.DeleteActionWithParameterCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>