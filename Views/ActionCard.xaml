<UserControl x:Class="DirectoryMonitor.Views.ActionCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Margin="0,0,0,8" Padding="12" CornerRadius="8" Background="{DynamicResource DustyBlueColorBrush}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Icon -->
            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20" Background="{DynamicResource SageGreenColorBrush}">
                <TextBlock Text="A" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
            </Border>

            <!-- Info -->
            <StackPanel Grid.Column="1" Margin="12,0">
                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14"/>
                <TextBlock Text="{Binding ActionType}" FontSize="11" Foreground="Gray"/>
                <TextBlock Text="{Binding ParametersSummary}" FontSize="11" Foreground="Gray" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Actions -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Edit" Width="60" Margin="5,0" 
                        Command="{Binding DataContext.EditActionWithParameterCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding}"/>
                <Button Content="Delete" Width="60" Margin="5,0"
                        Background="#F44336" Foreground="White"
                        Command="{Binding DataContext.DeleteActionWithParameterCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>