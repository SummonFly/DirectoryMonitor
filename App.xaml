<Application x:Class="DirectoryMonitor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DirectoryMonitor"
             xmlns:converters="clr-namespace:DirectoryMonitor.Converters"
             xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Application.Resources>

        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary>
                    <Color x:Key="DeepGreenColor">#223125</Color>
                    <Color x:Key="SageGreenColor">#729969</Color>
                    <Color x:Key="DustyBlueColor">#A1C0C2</Color>
                    <Color x:Key="LightGrayColor">#E6E7EB</Color>
                    <Color x:Key="SnowWhiteColor">#F6F6F6</Color>

                    <SolidColorBrush x:Key="DeepGreenColorBrush" Color="{DynamicResource DeepGreenColor}"/>
                    <SolidColorBrush x:Key="SageGreenColorBrush" Color="{DynamicResource SageGreenColor}"/>
                    <SolidColorBrush x:Key="DustyBlueColorBrush" Color="{DynamicResource DustyBlueColor}"/>
                    <SolidColorBrush x:Key="LightGrayColorBrush" Color="{DynamicResource LightGrayColor}"/>
                    <SolidColorBrush x:Key="SnowWhiteColorBrush" Color="{DynamicResource SnowWhiteColor}"/>

                    <FontFamily x:Key="MainFontFamily">Segoe UI Variable</FontFamily>
                    <sys:Double x:Key="FontBaseSize">14</sys:Double>
                </ResourceDictionary>
                
                <ResourceDictionary Source="/Themes/DarkTheme.xaml"/>

                <ResourceDictionary>
                    <converters:IsNotNullConverter x:Key="IsNotNullConverter"/>
                    <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
                    <converters:ListToStringConverter x:Key="ListToStringConverter"/>
                    <ContextMenu x:Key="TrayMenu">
                        <MenuItem Header="Show Window" Command="{Binding ShowWindowCommand}"/>
                        <Separator/>
                        <MenuItem Header="Exit" Command="{Binding ExitCommand}"/>
                    </ContextMenu>


                    <!--
    UI DESIGN NOTE:
    GRID AND PADS: Multiplicity of 8 (for example: 8, 16, 24, 32, 48).
    FONTS: Basic = 14px, Heading = 20px/24px, Small = 12px.
    GLASS (Glassmorphism): 
        - Light: Background="#1AFFFFFF" (10% transparency)
        - Dark: Background="#33000000" (20% transparency)
        - Corner rounding: CornerRadius="12"
-->

                    <!--Styles-->

                    <!--Text-->
                    <Style TargetType="TextBlock">
                        <Setter Property="FontFamily" Value="{DynamicResource MainFontFamily}"/>
                        <Setter Property="FontSize" Value="{DynamicResource FontBaseSize}"/>
                        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
                    </Style>
                    <Style TargetType="TextBox">
                        <Setter Property="FontFamily" Value="{DynamicResource MainFontFamily}"/>
                        <Setter Property="FontSize" Value="{DynamicResource FontBaseSize}"/>
                        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
                    </Style>

                    <Style x:Key="SecondaryText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Setter Property="FontSize" Value="12"/>
                    </Style>
                    <Style x:Key="WindowHeader" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Setter Property="FontSize" Value="32"/>
                    </Style>
                    <Style x:Key="CardTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Setter Property="FontSize" Value="20"/>
                    </Style>
                    <Style x:Key="SmallTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Setter Property="FontSize" Value="16"/>
                    </Style>



                    <Style x:Key="WindowStyle" TargetType="Window">
                        <Setter Property="Background" Value="{DynamicResource SnowWhiteColorBrush}"/>
                    </Style>

                    <Style x:Key="PrettyTabControl" TargetType="TabControl">
                        <Setter Property="Background" Value="{DynamicResource DeepGreenColorBrush}"/>
                        <Setter Property="TabStripPlacement" Value="Left"/>
                    </Style>

                    <Style x:Key="PrettyTabItem" TargetType="TabItem">
                        <Setter Property="Padding" Value="12,12"/>
                        <Setter Property="Margin" Value="0,0,0,8"/>
                        <Setter Property="BorderThickness" Value="1 1 0 1"/>
                        <Setter Property="Background" Value="{DynamicResource DustyBlueColorBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type TabItem}">
                                    <Border x:Name="TabBorder" 
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="8 0 0 8" 
                                            Margin="{TemplateBinding Margin}">
                                        <ContentPresenter x:Name="ContentSite"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Left"
                                            ContentSource="Header"
                                            Margin="{TemplateBinding Padding}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource SageGreenColorBrush}"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                        </Trigger>

                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource DeepGreenColorBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>


                    <Style x:Key="PrettyGrid" TargetType="Grid">
                        <Setter Property="Background" Value="{DynamicResource LightGrayColorBrush}"/>
                        <Setter Property="Margin" Value="1"/>
                    </Style>

                    
                    <Style x:Key="Substrate" TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource DustyBlueColorBrush}"/>
                        <Setter Property="CornerRadius" Value="4"/>
                        <Setter Property="Margin" Value="4"/>
                        <Setter Property="Padding" Value="8"/>
                    </Style>

                    <!--Button-->

                    <Style TargetType="Button">
                        <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
                        <Setter Property="Padding" Value="4"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="4" 
                                Background="{TemplateBinding Background}" 
                                BorderThickness="1" 
                                BorderBrush="LightGray"
                                Opacity="50">
                                        <ContentPresenter 
                                HorizontalAlignment="Center" 
                                VerticalAlignment="Center" 
                                Margin="4"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
