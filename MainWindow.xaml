<Window x:Class="DirectoryMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Directory Monitor" Height="600" Width="900"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <TabControl>
            <!-- Journal Tab -->
            <TabItem Header="Journal" x:Name="JournalTab">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Filters -->
                    <Border Grid.Row="0" Margin="0,0,0,10" Padding="5" BorderBrush="LightGray" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Label Content="Event Type:"/>
                            <ComboBox x:Name="EventTypeFilter" Width="120" Margin="5">
                                <ComboBoxItem Content="All" IsSelected="True"/>
                                <ComboBoxItem Content="Created"/>
                                <ComboBoxItem Content="Changed"/>
                                <ComboBoxItem Content="Deleted"/>
                                <ComboBoxItem Content="Renamed"/>
                            </ComboBox>

                            <Label Content="Search:" Margin="10,0,0,0"/>
                            <TextBox x:Name="SearchBox" Width="200" Margin="5"/>

                            <Button x:Name="RefreshButton" Content="Refresh" Width="80" 
                                Command="{Binding LoadEventsCommand}" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Events DataGrid -->
                    <DataGrid x:Name="EventsGrid" Grid.Row="1" AutoGenerateColumns="False" 
                              ItemsSource="{Binding Events}"
                              IsReadOnly="True" AlternatingRowBackground="LightGray">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="130"/>
                            <DataGridTextColumn Header="Event Type" Binding="{Binding EventType}" Width="100"/>
                            <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="*"/>
                            <DataGridTextColumn Header="Old Path" Binding="{Binding OldPath}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Watched Paths Tab -->
            <TabItem Header="Watched Paths">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Add Folder" Width="100" Margin="0,0,5,0"
                    Command="{Binding AddPathCommand}"/>
                        <Button Content="Remove" Width="100" Margin="0,0,5,0"
                    Command="{Binding RemovePathCommand}"
                    IsEnabled="{Binding SelectedWatchedPath, Converter={StaticResource IsNotNullConverter}}"/>
                        <Button Content="Refresh" Width="100"
                    Command="{Binding RefreshPathsCommand}"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1" AutoGenerateColumns="False" 
                  IsReadOnly="True" SelectionMode="Single"
                  SelectedItem="{Binding SelectedWatchedPath, Mode=TwoWay}"
                  ItemsSource="{Binding WatchedPaths}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="*"/>
                            <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="80"/>
                            <DataGridCheckBoxColumn Header="Include Subdirs" Binding="{Binding IncludeSubdirectories}" Width="120"/>
                            <DataGridTextColumn Header="Filter" Binding="{Binding FileExtensionsFilter}" Width="150"/>
                            <DataGridTextColumn Header="Created" Binding="{Binding CreatedAt, StringFormat=yyyy-MM-dd}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Rules Tab -->
            <TabItem x:Name="RulesTab" Header="Rules" FontWeight="SemiBold">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Toolbar -->
                    <Border Grid.Row="0" Background="#E8E8E8" Padding="8" CornerRadius="5" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Add" Width="80" Margin="0,0,5,0"
                        Command="{Binding AddRuleCommand}"
                        Background="#4CAF50" Foreground="White" BorderThickness="0" Padding="8,4"/>
                            <Button Content="Edit" Width="80" Margin="5,0,5,0"
                        Command="{Binding EditRuleCommand}"
                        Background="#2196F3" Foreground="White" BorderThickness="0" Padding="8,4"/>
                            <Button Content="Delete" Width="80" Margin="5,0,5,0"
                        Command="{Binding DeleteRuleCommand}"
                        Background="#F44336" Foreground="White" BorderThickness="0" Padding="8,4"/>
                        </StackPanel>
                    </Border>

                    <!-- Rules DataGrid -->
                    <DataGrid x:Name="RulesGrid" Grid.Row="1" AutoGenerateColumns="False" 
                              IsReadOnly="True" AlternatingRowBackground="#FAFAFA"
                              SelectedItem="{Binding SelectedRule, Mode=TwoWay}"
                              ItemsSource="{Binding Rules}"
                              BorderBrush="#D0D0D0" RowHeight="35">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="70"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Event Type" Binding="{Binding EventType}" Width="120"/>
                            <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Rules Log -->
            <TabItem x:Name="RuleLogTab" Header="Rule Log" FontWeight="SemiBold">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#E8E8E8" Padding="8" CornerRadius="5" Margin="0,0,0,10">
                        <Button Content="Clear Log" Width="100" Command="{Binding ClearLogsCommand}"
                    Background="#F44336" Foreground="White" BorderThickness="0" Padding="8,4"/>
                    </Border>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Logs}" AutoGenerateColumns="False"
                        AlternatingRowBackground="#FAFAFA" BorderBrush="#D0D0D0" RowHeight="35">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="140"/>
                            <DataGridTextColumn Header="Rule" Binding="{Binding RuleName}" Width="150"/>
                            <DataGridTextColumn Header="Event Type" Binding="{Binding EventType}" Width="100"/>
                            <DataGridTextColumn Header="Path" Binding="{Binding EventPath}" Width="*"/>
                            <DataGridCheckBoxColumn Header="Success" Binding="{Binding Success}" Width="80"/>
                            <DataGridTextColumn Header="Error" Binding="{Binding ErrorMessage}" Width="200"/>
                            <DataGridTextColumn Header="Time (ms)" Binding="{Binding ExecutionTimeMs}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>